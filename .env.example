# Copy to .env and fill in. .env is gitignored — never commit a real seed.
# Generate a fresh seed with: openssl rand -hex 32
VEILPAY_WALLET_SEED=

# preview (default) or preprod
VEILPAY_NETWORK=preview

# Proof server URL; start it with `npm run proof-server`
VEILPAY_PROOF_SERVER=http://127.0.0.1:6300

# Initial public policy version
VEILPAY_POLICY_VERSION=1

# Initial private budget. Stays on this machine, never sent to the network.
VEILPAY_BUDGET=1000

# How long to wait for the initial wallet sync, in milliseconds.
# A fresh seed on Preview often needs several minutes.
VEILPAY_SYNC_TIMEOUT_MS=3600000
